# Backend (Render > Environment). Never commit the real .env
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only, never in the frontend
ADMIN_KEY=                      # long random string
ALLOWED_ORIGINS=https://YOUR-SITE.netlify.app
CACHE_DIR=/var/data/cache
CRON_SECRET=                    # long random string; the scheduler sends it in X-Cron-Secret
VAPID_PRIVATE_KEY=              # web push keys: npx web-push generate-vapid-keys
VAPID_EMAIL=you@email.com
